FaceLandmarksConnections = mp.tasks.vision.FaceLandmarksConnections
PoseLandmarksConnections = mp.tasks.vision.PoseLandmarksConnections

# Skeleton connections for the 21 hand landmarks
HAND_CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4),        # Thumb
    (0, 5), (5, 6), (6, 7), (7, 8),        # Index
    (5, 9), (9, 10), (10, 11), (11, 12),   # Middle
    (9, 13), (13, 14), (14, 15), (15, 16), # Ring
    (13, 17), (0, 17), (17, 18), (18, 19), (19, 20) # Pinky & palm
]

latest_result = None

def on_result(result, output_image: mp.Image, timestamp_ms: int):
    global latest_result
    latest_result = result

