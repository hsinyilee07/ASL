def draw_holistic_landmarks(frame, result):

    height, width, _ = frame.shape

    canvas = np.zeros((height, width, 3), dtype=np.uint8)
   
    if not result:
        return canvas

    # 1. Draw Face Mesh (478 landmarks)
    if result.face_landmarks:
        face_points = [(int(lm.x * width), int(lm.y * height)) for lm in result.face_landmarks]

        for connection in FaceLandmarksConnections.FACE_LANDMARKS_TESSELATION:
            cv2.line(canvas, face_points[connection.start], face_points[connection.end], (180, 180, 180), 1)

        for connection in FaceLandmarksConnections.FACE_LANDMARKS_CONTOURS:
            cv2.line(canvas, face_points[connection.start], face_points[connection.end], (255, 255, 0), 8)

    # 2. Draw Pose Skeleton (33 body landmarks)
    # if result.pose_landmarks:
    #     pose_points = [(int(lm.x * width), int(lm.y * height)) for lm in result.pose_landmarks]

    #     for connection in PoseLandmarksConnections.POSE_LANDMARKS:
    #         cv2.line(canvas, pose_points[connection.start], pose_points[connection.end], (0, 0, 0), 2)

    #     for px, py in pose_points:
    #         cv2.circle(canvas, (px, py), 5, (0, 0, 0), -1)

    # 3. Draw Left & Right Hands (21 landmarks each)
    for hand_landmarks in (result.left_hand_landmarks, result.right_hand_landmarks):
        if hand_landmarks:
            hand_points = [(int(lm.x * width), int(lm.y * height)) for lm in hand_landmarks]

            for start_idx, end_idx in HAND_CONNECTIONS:
                cv2.line(canvas, hand_points[start_idx], hand_points[end_idx], (0, 255, 0), 6)

            for px, py in hand_points:
                cv2.circle(canvas, (px, py), 8, (0, 0, 255), -1)

    return canvas

options = HolisticLandmarkerOptions(
    base_options=BaseOptions(model_asset_path="./landmarker_weights/holistic_landmarker.task"),
    running_mode=VisionRunningMode.LIVE_STREAM,
    min_face_detection_confidence=0.5,
    min_pose_detection_confidence=0.5,
    result_callback=on_result,
)

cap = cv2.VideoCapture(0)

with HolisticLandmarker.create_from_options(options) as landmarker:
    while cap.isOpened():
        success, frame = cap.read()
        if not success:
            continue

        frame = cv2.flip(frame, 1)
        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)
        timestamp_ms = int(time.time() * 1000)

        # Async: automatically drops incoming camera frames when busy so results stay current
        landmarker.detect_async(mp_image, timestamp_ms)

        annotated_frame = draw_holistic_landmarks(frame, latest_result)

        cv2.imshow("Holistic Landmarker (Face + Pose + Hands)", annotated_frame)
        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

cap.release()
cv2.destroyAllWindows()